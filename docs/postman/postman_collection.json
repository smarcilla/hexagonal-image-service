{
  "info": {
    "name": "Hexagonal Image Service - Tasks",
    "_postman_id": "a1b2c3d4-hex-img-service",
    "description": "Collection to test /tasks endpoint (create and query). Use {{baseUrl}} env variable (default http://localhost:3000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Task - valid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"/tmp/example.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Expect a successful creation (200 or 201) and an id in the response body",
              "pm.test('status is 200 or 201', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200,201]);",
              "});",
              "var json = {};",
              "try { json = pm.response.json(); } catch (e) { json = {}; }",
              "pm.test('response has id', function () {",
              "    pm.expect(json).to.have.property('id');",
              "    pm.collectionVariables.set('taskId', json.id);",
              "});",
              "// Helpful info",
              "console.log('Created task id:', pm.collectionVariables.get('taskId'))"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Task - invalid (empty source)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// For invalid input we expect an error status (4xx or 5xx). Exact code may vary depending on validation/exception mapping",
              "pm.test('error status code', function () {",
              "    pm.expect(pm.response.code).to.be.at.least(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Task by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Ensure we have a taskId from the previous request",
              "if (!pm.collectionVariables.get('taskId')) {",
              "    console.warn('No taskId set in collection variables. Make sure to run Create Task - valid first.');",
              "}",
              "",
              "// noop"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// The processing is asynchronous. Immediately after creation task is expected to be 'pending' and have 0 variants.",
              "// Later it may transition to 'completed' with exactly 2 variants. Accept either state here.",
              "var json = {};",
              "try { json = pm.response.json(); } catch (e) { json = {}; }",
              "pm.test('response code is 200', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200,201]);",
              "});",
              "pm.test('has id or found:false', function () {",
              "    pm.expect(json).to.be.an('object');",
              "});",
              "pm.test('status is pending or completed', function () {",
              "    if (json.found === false) {",
              "        pm.expect(json.found).to.equal(false);",
              "    } else {",
              "        pm.expect(['pending','completed','failed']).to.include(json.status);",
              "    }",
              "});",
              "pm.test('variants either 0 (pending) or 2 (completed)', function () {",
              "    if (json.found === false) {",
              "        pm.expect(json.found).to.equal(false);",
              "    } else {",
              "        pm.expect(json.variants).to.be.an('array');",
              "        pm.expect([0,2]).to.include(json.variants.length);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
